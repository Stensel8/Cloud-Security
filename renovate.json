{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "forkProcessing": "enabled",
  "prConcurrentLimit": 0,
  "automerge": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  }
}
